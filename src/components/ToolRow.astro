---
import type { ToolNews } from "../digest.ts";

const KIND = { release: "릴리스", api: "새 API 문서", post: "블로그" };
const { news: t } = Astro.props as { news: ToolNews };
---

<li class="tool">
  <time class="margin num" datetime={t.date}>{t.date.slice(5).replace("-", ".")}</time>
  <a class="tool-link" href={t.url} target="_blank" rel="noopener"><span class="tool-name">{t.tool}</span> {t.text}</a>
  <span class="tool-kind">{KIND[t.kind]}</span>
</li>
