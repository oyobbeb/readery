---
import type { Entry } from "../digest.ts";

// One item in a day list. The margin holds how many places it was seen in; the column holds only the title.
// Discussion threads are chips (tappable); a feed's own name is plain text.
const { entry: e } = Astro.props as { entry: Entry };
---

<li class="entry">
  <span class:list={["margin", "places", e.places >= 3 && "hot"]}>
    {e.places > 1 && <><span class="n">{e.places}</span>곳<span class="sr">에서 화제</span></>}
  </span>
  <div class="entry-body">
    <a class="entry-title" href={e.url} target="_blank" rel="noopener">{e.title}</a>
    <p class="entry-meta">
      <span class="site">{e.site}</span>
      {e.mentions.map((m) => (m.url ? <a class="chip" href={m.url} target="_blank" rel="noopener">{m.name}</a> : <span class="plain">{m.name}</span>))}
    </p>
  </div>
</li>
